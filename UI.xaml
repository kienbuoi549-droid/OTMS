<!-- ============================================================
     AI-5 — OTMSAnalyzer V10 (WPF XAML)
     ============================================================ -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTMSAnalyzer V10"
        WindowStyle="None" AllowsTransparency="False"
        WindowState="Maximized"
        Background="#F2F2F7"
        FontFamily="Segoe UI" FontSize="13">
<Window.Resources>

  <Style x:Key="PB" TargetType="ProgressBar">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}" CornerRadius="4"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnP" TargetType="Button">
    <Setter Property="Background" Value="#1E3A8A"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPurple" TargetType="Button" BasedOn="{StaticResource BtnP}">
    <Setter Property="Background" Value="#6D5BD0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#5B4BC4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnS" TargetType="Button">
    <Setter Property="Background" Value="#F1F5F9"/>
    <Setter Property="Foreground" Value="#475569"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Style riêng cho hành động "thêm mới" (vd nút + Thêm Model) - tông xanh lá, tách biệt
       với BtnS (xám, dùng cho Huỷ/hành động trung tính). Nền #F0FDF4 lấy ĐÚNG màu đã dùng
       sẵn để tô dòng model mới thêm trong THEM_DONG_MODEL, giữ nhất quán ngôn ngữ màu sắc. -->
  <Style x:Key="BtnGreen" TargetType="Button">
    <Setter Property="Background" Value="#F0FDF4"/>
    <Setter Property="Foreground" Value="#16A34A"/>
    <Setter Property="BorderBrush" Value="#BBF7D0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Style riêng cho nút ĐÓNG (dấu X) trên các popup/lớp phủ - trung tính lúc bình
       thường, ngả sang tông đỏ nhạt khi rê chuột (quy ước phổ biến: đóng/thoát = đỏ khi
       hover). Nền hover #FFF1F0 lấy ĐÚNG màu đã dùng cho khung lỗi Khung_Loi_Dang_Nhap /
       Khung_Loi_Xac_Thuc trong dự án, giữ nhất quán ngôn ngữ màu sắc.
       Lưu ý: CHỈ đổi Background qua Trigger (TargetName="bd") giống các style Btn khác,
       không đổi Foreground qua trigger, vì Setter không khai TargetName trong
       ControlTemplate.Triggers sẽ mặc định áp lên phần tử GỐC của template (ở đây là
       Border "bd"), mà Border không có thuộc tính Foreground nên sẽ lỗi lúc chạy. -->
  <Style x:Key="BtnClose" TargetType="Button">
    <Setter Property="Background" Value="#F1F5F9"/>
    <Setter Property="Foreground" Value="#64748B"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FFF1F0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="TBX" TargetType="TextBox">
    <Setter Property="BorderBrush" Value="#E2E8F0"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="#F8FAFC"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#005696"/>
              <Setter TargetName="bd" Property="Background" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PWBX" TargetType="PasswordBox">
    <Setter Property="BorderBrush" Value="#E2E8F0"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="#F8FAFC"/>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#F8FAFC"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="ValidationErrorTemplate" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F0F7FF"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#EFF6FF"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridRowHeader">
    <Setter Property="Width" Value="0"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Padding="8,5" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DGHeaderBase" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#FAFAFA"/>
    <Setter Property="Foreground" Value="#6C757D"/>
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="BorderBrush" Value="#E9ECEF"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="8,8">
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Style ngầm định (không key) áp cho MỌI DataGridColumnHeader chưa khai báo HeaderStyle riêng -->
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderBase}"/>
  <!-- Biến thể cho cột giá trị số (PLAN, Q'TY HOUR, BOX, REMAIN, HOUR) -->
  <Style x:Key="DGHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderBase}">
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
  </Style>
  <!-- Biến thể cho cột tiến độ (progress bar, nội dung phức hợp căn giữa) -->
  <Style x:Key="DGHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderBase}">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="5"/>
    <Setter Property="MinWidth" Value="5"/>
  </Style>

  <!-- Hover cho từng dòng lò nướng trong Danh_Sach_Lo_1/2 — giá trị nền GỐC (White) phải
       đặt trong Setter ở đây, KHÔNG đặt Background trực tiếp trên thẻ Border lúc dùng,
       nếu không local value sẽ đè mất Trigger IsMouseOver và hover sẽ không hoạt động. -->
  <Style x:Key="OvenRow" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#F1F5F9"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#DBEAFE"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Hover cho từng dòng trong bảng Top Ranking (Danh_Sach_Xep_Hang_1/2) -->
  <Style x:Key="RankRow" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E2E8F0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Màu chữ cho phần "(BAKING)"/"(COOLING)"/"(RISING)" trong cột Trạng thái — so khớp
       StatusParenKey (từ khoá đã tách sẵn trong ngoặc, xem OvenBaking.psm1). Chỉ đổi màu
       CHỮ, không có nền/pill, để "Status: Baking(...)" đọc liền thành 1 dòng như dữ liệu gốc. -->
  <Style x:Key="StatusParenText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#64748B"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusParenKey}" Value="BAKING">
        <Setter Property="Foreground" Value="#0071E3"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusParenKey}" Value="COOLING">
        <Setter Property="Foreground" Value="#22C55E"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusParenKey}" Value="RISING">
        <Setter Property="Foreground" Value="#F59E0B"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Công tắc trượt (toggle switch) cho các lựa chọn bật/tắt (vd "Ghi log hệ thống") —
       BÊN DƯỚI VẪN LÀ CheckBox (chỉ đổi ControlTemplate hiển thị), nên IsChecked hoạt
       động y hệt checkbox thường — code PowerShell đọc/gán $el.IsChecked KHÔNG cần đổi
       gì. Track màu #005696 (đúng tông xanh chủ đạo dùng xuyên suốt app) khi bật, #CBD5E1
       khi tắt; nút tròn trượt có bóng đổ nhẹ, có hoạt ảnh mượt khi đổi trạng thái. -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="44" Height="24">
            <Border x:Name="Track" CornerRadius="12" Background="#CBD5E1" BorderThickness="0"/>
            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="White"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
              <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
              </Border.Effect>
              <Border.RenderTransform>
                <TranslateTransform x:Name="ThumbTransform" X="0"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#005696"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                     To="20" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</Window.Resources>


<Grid x:Name="rootGrid">

  <!-- MAIN LAYOUT -->
  <Grid Panel.ZIndex="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="65"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- SIDEBAR -->
    <Border x:Name="Thanh_Dieu_Huong" Grid.ColumnSpan="2" Width="72" HorizontalAlignment="Left"
            Background="White" Panel.ZIndex="5000"
            BorderBrush="#14000000" BorderThickness="0,0,1,0" ClipToBounds="True">
      <Border.CornerRadius>0,20,20,0</Border.CornerRadius>
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="0" Color="#000000" Opacity="0.05"/>
      </Border.Effect>
      <Border.Triggers>
        <EventTrigger RoutedEvent="Border.MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Thanh_Dieu_Huong"
                Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Khung_Logo"
                Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Khung_Thong_Tin_Phien_Ban"
                Storyboard.TargetProperty="Opacity"
                To="1" Duration="0:0:0.2" BeginTime="0:0:0.15"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="Border.MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Thanh_Dieu_Huong"
                Storyboard.TargetProperty="Width" To="73" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Khung_Logo"
                Storyboard.TargetProperty="Width" To="75" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Khung_Thong_Tin_Phien_Ban"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:0.1"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Border.Triggers>

      <DockPanel LastChildFill="False">
        <!-- Logo -->
        <Border x:Name="Khung_Logo" DockPanel.Dock="Top" Height="65" Width="72" HorizontalAlignment="Left" ClipToBounds="True">
          <Viewbox Width="44" Height="20" HorizontalAlignment="Center">
            <Canvas Width="48" Height="22">
              <Path Data="M2,2 L2,14 Q2,20 8,20 Q14,20 14,14 L14,2"
                    Stroke="#005696" StrokeThickness="3" Fill="Transparent"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path Data="M30,5 Q30,2 24,2 Q18,2 18,6 Q18,10 24,11 Q30,12 30,16 Q30,20 24,20 Q18,20 18,17"
                    Stroke="#005696" StrokeThickness="3" Fill="Transparent"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Line X1="34" Y1="2"  X2="46" Y2="2"  Stroke="#005696" StrokeThickness="3" StrokeStartLineCap="Round"/>
              <Line X1="40" Y1="2"  X2="40" Y2="20" Stroke="#005696" StrokeThickness="3" StrokeStartLineCap="Round"/>
              <Line X1="34" Y1="20" X2="46" Y2="20" Stroke="#005696" StrokeThickness="3" StrokeStartLineCap="Round"/>
            </Canvas>
          </Viewbox>
        </Border>

        <!-- Nav items -->
        <StackPanel DockPanel.Dock="Top" Width="280" HorizontalAlignment="Left">
          <!-- Home -->
          <Border x:Name="Nav_Trang_Chu" Height="44" Cursor="Hand" Width="280">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#EFF6FF"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DBEAFE"/></Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel Margin="24,0,0,0" VerticalAlignment="Center">
              <Border DockPanel.Dock="Right" Width="3" Background="#005696" VerticalAlignment="Stretch"/>
              <Viewbox Width="18" Height="18" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="M3,12 L12,3 L21,12 M5,10 V21 H19 V10 M9,21 V12 H15 V21"
                        Stroke="#005696" StrokeThickness="1.8" Fill="Transparent"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Tổng quan" Margin="33,0,0,0" FontWeight="SemiBold" FontSize="13" Foreground="#005696" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <!-- Search -->
          <Border x:Name="Nav_Tim_Kiem" Height="44" Cursor="Hand" Width="280">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC"/></Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel Margin="24,0,0,0" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="2" Canvas.Top="2" Width="18" Height="18" Stroke="#64748B" StrokeThickness="1.8" Fill="Transparent"/>
                  <Line X1="16.5" Y1="16.5" X2="22" Y2="22" Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Tìm kiếm nâng cao" Margin="33,0,0,0" FontWeight="SemiBold" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <!-- Production settings -->
          <Border x:Name="Nav_Cai_Dat_San_Luong" Height="44" Cursor="Hand" Width="280">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC"/></Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel Margin="24,0,0,0" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Rectangle Canvas.Left="3"  Canvas.Top="12" Width="4"  Height="9"  RadiusX="1" RadiusY="1" Stroke="#64748B" StrokeThickness="1.8" Fill="Transparent"/>
                  <Rectangle Canvas.Left="10" Canvas.Top="7"  Width="4"  Height="14" RadiusX="1" RadiusY="1" Stroke="#64748B" StrokeThickness="1.8" Fill="Transparent"/>
                  <Rectangle Canvas.Left="17" Canvas.Top="3"  Width="4"  Height="18" RadiusX="1" RadiusY="1" Stroke="#64748B" StrokeThickness="1.8" Fill="Transparent"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Cài đặt sản lượng" Margin="33,0,0,0" FontWeight="SemiBold" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <!-- General settings -->
          <Border x:Name="Nav_Cai_Dat_Chung" Height="44" Cursor="Hand" Width="280">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC"/></Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
