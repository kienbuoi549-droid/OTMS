                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="{Binding ActGridWRem}"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding ActTimeStr}" FontSize="8"
                                       Foreground="#0071E3" HorizontalAlignment="Center"/>
                          </Grid>
                        </Grid>

