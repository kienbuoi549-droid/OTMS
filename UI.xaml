                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding TgtGridW}"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="{Binding TgtGridWRem}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Background="#E8EDF2" CornerRadius="3"
                                    Padding="4,1" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding TgtSipVal}" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                            </Border>
                          </Grid>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding ActGridW}"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="{Binding ActGridWRem}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3"
                                    Padding="4,1" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding ActSipVal}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                            </Border>
                          </Grid>
                        </Grid>

                        <Grid Grid.Row="2">
                          <Border Background="#F0F0F2" CornerRadius="4"/>
                          <ProgressBar Style="{StaticResource PB}" Value="{Binding TargetPct}" Height="8" Foreground="#BFDBFE" Background="Transparent"/>
                          <ProgressBar Style="{StaticResource PB}" Value="{Binding ActualPct}" Height="6" Foreground="#0071E3" Background="Transparent" VerticalAlignment="Center"/>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="REMAIN" Width="82" IsReadOnly="True" HeaderStyle="{StaticResource DGHeaderCenter}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding RemainFmt}" TextAlignment="Center" FontWeight="Bold">
