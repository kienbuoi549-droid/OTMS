<!-- ============================================================
     MiniMap.xaml — OTMSAnalyzer V10 (WPF XAML)
     Popup MiniMap lò nướng (mockup MiniMap.txt -> XAML) 500x370
     Neo góc phải-dưới màn hình, luôn nổi trên (Topmost).
     V2.4: NỐI DỮ LIỆU THẬT từ 2 nguồn (không còn dữ liệu mẫu cứng):
       1. Active.db  — oven đang theo dõi của từng line: OVEN ID / FINISH /
          MAG (số kệ) / TOTAL SIP / đếm ngược / danh sách model (SP_Models)
       2. yyyymmdd.db — (mốc thời gian ca làm việc hôm nay) BATCH có finish gần
          nhất (≤ hiện tại) theo line: MM_Done* (OVEN HOÀN THÀNH GẦN NHẤT)
       V2.6: thông tin Done* lấy ĐÚNG batch có finish gần nhất trong lò
       (không cộng dồn các lô đã ra trước đó); file thật được mã hoá
       AES+GZip — NAP_DB_LICH_SU_NGAY tự nhận diện cả 2 định dạng.
     Tên 2 line (Line_Btn_*) lấy theo SETTINGS.items.
     Điều hướng chấm macOS:
       Cham_Do   = thoát ứng dụng
       Cham_Vang = ẩn (minimize) xuống taskbar
       Cham_Xanh = đóng giao diện này, mở OvenRanking.xaml
     ============================================================ -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniMap"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize" ShowActivated="True"
        Width="524" Height="394"
        FontFamily="Segoe UI" FontSize="13">

  <!-- Khung popup: bo góc 18 + đổ bóng (giống .popup của mockup) -->
  <Border x:Name="Khung_Popup" Background="White" BorderBrush="#E8EDF5" BorderThickness="1"
          CornerRadius="18" Width="500" Height="370" Margin="12" ClipToBounds="False">
    <Border.Effect>
      <DropShadowEffect Color="#0F172A" BlurRadius="30" ShadowDepth="0" Opacity="0.12"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ══════════ HEADER: 3 chấm + line toggle ══════════ -->
      <Grid Grid.Row="0" Background="Transparent" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Grid x:Name="Cham_Do" Width="12" Height="12" Cursor="Hand" Margin="0,0,8,0"
                Background="Transparent" ToolTip="Đóng ứng dụng">
            <Ellipse Fill="#FF5F57" StrokeThickness="0"/>
          </Grid>
          <Grid x:Name="Cham_Vang" Width="12" Height="12" Cursor="Hand" Margin="0,0,8,0"
                Background="Transparent" ToolTip="Ẩn xuống taskbar">
            <Ellipse Fill="#FEBC2E" StrokeThickness="0"/>
          </Grid>
          <Grid x:Name="Cham_Xanh" Width="12" Height="12" Cursor="Hand" Background="Transparent"
                ToolTip="Mở Oven Ranking">
            <Ellipse Fill="#28C840" StrokeThickness="0"/>
          </Grid>
        </StackPanel>

        <!-- Line toggle: 1 vùng bấm duy nhất, bấm bất kỳ đâu trong pill đều chuyển line -->
        <Grid x:Name="Line_Toggle" HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="158" Height="30" Background="Transparent" Cursor="Hand"
              ToolTip="Bấm để chuyển line">
          <Border Background="#F1F5F9" CornerRadius="15"/>
          <Border x:Name="Line_Thumb" Background="#2563EB" CornerRadius="15"
                  Width="76" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Margin="3,0,0,0">
            <Border.RenderTransform>
              <TranslateTransform x:Name="Line_Thumb_X" X="0"/>
            </Border.RenderTransform>
          </Border>
          <UniformGrid Columns="2">
            <TextBlock x:Name="Line_Btn_C105" Text="C10.5" FontSize="12" FontWeight="Bold"
                       Foreground="White" TextAlignment="Center" VerticalAlignment="Center" Padding="0,6"/>
            <TextBlock x:Name="Line_Btn_Hades" Text="Hades" FontSize="12" FontWeight="Bold"
                       Foreground="#6B7280" TextAlignment="Center" VerticalAlignment="Center" Padding="0,6"/>
          </UniformGrid>
        </Grid>
      </Grid>

      <!-- ══════════ INFO: OVEN ID / FINISH / MAG / TOTAL ══════════ -->
      <Border Grid.Row="1" Background="White" BorderBrush="#EDF2F7" BorderThickness="1"
              CornerRadius="14" Margin="14,14,14,0" Padding="18,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="OVEN ID" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="FINISH" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,10,0"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="MAG" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,10,0"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="TOTAL" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
          <TextBlock x:Name="MM_OvenId" Grid.Row="1" Grid.Column="0" Text="--"
                     FontSize="15" FontWeight="Bold" Foreground="#1F2937"/>
          <TextBlock x:Name="MM_Finish" Grid.Row="1" Grid.Column="1" Text="--"
                     FontSize="15" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,10,0"/>
          <TextBlock x:Name="MM_Mag" Grid.Row="1" Grid.Column="2" Text="--"
                     FontSize="15" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,10,0"/>
          <TextBlock x:Name="MM_Total" Grid.Row="1" Grid.Column="3" Text="-- SIP"
                     FontSize="15" FontWeight="Bold" Foreground="#2563EB"/>
        </Grid>
      </Border>

      <!-- ══════════ DETAIL: countdown | model list ══════════ -->
      <Border Grid.Row="2" Background="White" BorderBrush="#EDF2F7" BorderThickness="1"
              CornerRadius="14" Margin="14,14,14,0" ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
          </Grid.ColumnDefinitions>

          <!-- Countdown còn lại -->
          <Border Grid.Column="0" BorderBrush="#EDF2F7" BorderThickness="0,0,1,0" Padding="6,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop x:Name="GS_Rem_1" Color="#FCFDFF" Offset="0"/>
                <GradientStop x:Name="GS_Rem_2" Color="#F5F9FF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="MM_RemHour" Text="--" FontSize="16" FontWeight="SemiBold"
                         Foreground="#6B7280" TextAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock x:Name="MM_RemTime" Text="--" FontSize="34" FontWeight="Bold"
                         Foreground="#2563EB" TextAlignment="Center"/>
              <Border x:Name="MM_Badge" Background="#DC2626" CornerRadius="10" Padding="10,3"
                      HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MM_Badge_Text" Text="SẮP XONG" FontSize="10" FontWeight="ExtraBold"
                           Foreground="White"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Danh sách model theo line -->
          <Border Grid.Column="1" Background="White">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="16,12,16,0" BorderBrush="#F2F2F2" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MODEL ID" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                <TextBlock Grid.Column="1" Text="SIP" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                <StackPanel>
                  <!-- V2.4: danh sách model của line đang chọn — code dựng từng hàng
                       (model | tổng SIP) vào SP_Models, nguồn = Active.db (oven đang
                       theo dõi của line). Không còn dữ liệu mẫu cứng. -->
                  <StackPanel x:Name="SP_Models"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ══════════ OVEN HOÀN THÀNH GẦN NHẤT ══════════
           V2.6: dữ liệu lấy từ yyyymmdd.db — ĐÚNG batch có finish gần nhất
           (≤ hiện tại) trong lò; MM_DoneId = "mã lò • Lô cycle",
           MM_DoneTotal = tổng SIP của riêng batch đó. -->
      <Border Grid.Row="3" CornerRadius="0,0,17,17" Padding="18,14" Cursor="Hand">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FBFEFC" Offset="0"/>
            <GradientStop Color="#F5FBF7" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Ellipse Width="8" Height="8" Fill="#28C840" VerticalAlignment="Center">
              <Ellipse.Effect>
                <DropShadowEffect Color="#28C840" BlurRadius="0" ShadowDepth="0" Opacity="0.15"/>
              </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="OVEN HOÀN THÀNH GẦN NHẤT" FontSize="12" FontWeight="Bold"
                       Foreground="#16A34A" Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock x:Name="MM_DoneId" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock x:Name="MM_DoneTime" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                <TextBlock Text=" • " FontSize="12" Foreground="#9CA3AF"/>
                <TextBlock x:Name="MM_DoneAgo" Text="Đang tải..." FontSize="12" Foreground="#16A34A"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" TextBlock.TextAlignment="Right">
              <TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF"/>
              <TextBlock x:Name="MM_DoneTotal" Text="-- SIP" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
