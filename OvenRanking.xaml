<!-- ============================================================
     OvenRanking.xaml — OTMSAnalyzer V10 (WPF XAML)
     Giao diện xếp hạng lò nướng (full màn).
     V2.4: NỐI DỮ LIỆU THẬT từ Active.db (qua $global:OVEN_DATA do
     Runspace_LO cập nhật) — KHÔNG còn dữ liệu mẫu cứng:
       - Tên card / "N lò" / tổng SIP : theo SETTINGS.items + Active.db
       - Bảng lò (OVEN ID/TRẠNG THÁI/HOÀN THÀNH) : Card{1,2}_Rows,
         code dựng từng hàng theo danh sách oven của card
       - TOP RANKING (huy chương vàng/bạc/đồng)   : Card{1,2}_Rank,
         code dựng theo top model đếm từ Active.db
       - Popup chi tiết từng lò : code tạo Border đưa vào
         Card{1,2}_KhuVucDuoi (phủ đè vùng Top Ranking, ZIndex 20)
     Điều hướng chấm macOS:
       Cham_Do   = thoát ứng dụng
       Cham_Vang = đóng giao diện này, về UI.xaml
       Cham_Xanh = đóng giao diện này, mở MiniMap.xaml
     ============================================================ -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oven Ranking"
        WindowStyle="None" AllowsTransparency="False"
        WindowState="Maximized"
        Background="#DBE4EE"
        FontFamily="Segoe UI" FontSize="13">
<Window.Resources>

  <!-- Chấm macOS: nền sáng dần khi hover (giống .dot:hover brightness) -->
  <Style x:Key="DotE" TargetType="Ellipse">
    <Setter Property="StrokeThickness" Value="0.5"/>
    <Setter Property="Stroke" Value="#2E000000"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Fill" Value="#E6E6E6"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Hàng lò: nền #FFF khi thường, #F0F7FF khi hover (giống .oven-row:hover) -->
  <Style x:Key="RowLo" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#F1F5F9"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F0F7FF"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Hàng xếp hạng: viền sáng xanh khi hover (giống .rank-label:hover) -->
  <Style x:Key="RowHang" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E2E8F0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F0F7FF"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Pill thống kê trên header card -->
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
  </Style>

</Window.Resources>

  <!-- ══════════ TITLEBAR kiểu macOS ══════════ -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#ECECF1" BorderBrush="#14000000" BorderThickness="0,0,0,1">
      <Grid>
        <!-- 3 chấm điều hướng — màu sắc/hiệu ứng giữ nguyên 100% từ bản gốc -->
        <StackPanel x:Name="Khung_Cham_Tieu_De" Orientation="Horizontal"
                    Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent">
          <Grid x:Name="Cham_Do" Width="12" Height="12" Cursor="Hand" Margin="0,0,7,0">
            <Ellipse Fill="#FF5F57" StrokeThickness="0.5" Stroke="#2E000000"/>
            <Path x:Name="dotRedIcon" Data="M2,2 L6,6 M6,2 L2,6" Stroke="#6E120D" StrokeThickness="1.25"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Fill" Opacity="0"/>
          </Grid>
          <Grid x:Name="Cham_Vang" Width="12" Height="12" Cursor="Hand" Margin="0,0,7,0">
            <Ellipse Fill="#FEBC2E" StrokeThickness="0.5" Stroke="#2E000000"/>
            <Path x:Name="dotYellowIcon" Data="M1,4 H7" Stroke="#5A3A00" StrokeThickness="1.25"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Fill" Opacity="0"/>
          </Grid>
          <Grid x:Name="Cham_Xanh" Width="12" Height="12" Cursor="Hand">
            <Ellipse Fill="#28C840" StrokeThickness="0.5" Stroke="#2E000000"/>
            <Path x:Name="dotGreenIcon" Data="M4.3,1.5 H6.5 V3.7 M6.5,1.5 L4,4 M3.7,6.5 H1.5 V4.3 M1.5,6.5 L4,4"
                  Stroke="#0A3D0A" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                  Width="8" Height="8" Stretch="Fill" Opacity="0"/>
          </Grid>
          <StackPanel.Triggers>
            <EventTrigger RoutedEvent="StackPanel.MouseEnter">
              <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="dotRedIcon"    Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="dotYellowIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="dotGreenIcon"  Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
              </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="StackPanel.MouseLeave">
              <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="dotRedIcon"    Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="dotYellowIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="dotGreenIcon"  Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
              </Storyboard></BeginStoryboard>
            </EventTrigger>
          </StackPanel.Triggers>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══════════ BODY: 2 card lò (theo SETTINGS.items — C10.5 | Hades) ══════════ -->
    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ═══════════ CARD 1 (loại lò thứ 1 trong SETTINGS.items) ═══════════ -->
      <Border Grid.Column="0" Background="White" BorderBrush="#14000000" BorderThickness="1" CornerRadius="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Header card: tên loại lò + số lò + tổng SIP (code gán theo dữ liệu thật) -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,9,14,9">
            <Ellipse Width="8" Height="8" Fill="#005696" VerticalAlignment="Center"/>
            <TextBlock x:Name="Card1_Ten" Text="---" FontSize="13" FontWeight="Bold" Foreground="#005696"
                       Margin="7,0,0,0" VerticalAlignment="Center"/>
            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="Card1_SoLuong" Text="0 lò" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
            </Border>
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                    Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="Card1_TongSip" Text="0 SIP" FontSize="10" FontWeight="ExtraBold" Foreground="#005696"/>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="6*"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <!-- Bảng lò: hàng lò do code dựng vào Card1_Rows -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E8EDF2" BorderThickness="1" CornerRadius="12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Header bảng -->
                <Grid Grid.Row="0" Margin="0,7" Background="White">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.2*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2.4*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="OVEN ID" FontSize="9" Foreground="#94A3B8" Margin="10,0"/>
                  <TextBlock Grid.Column="1" Text="TRẠNG THÁI" FontSize="9" Foreground="#94A3B8"/>
                  <TextBlock Grid.Column="2" Text="HOÀN THÀNH" FontSize="9" Foreground="#94A3B8"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="Card1_Rows"/>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- Vùng dưới: TOP RANKING + popup chi tiết lò (code thêm Border vào đây) -->
            <Grid Grid.Row="2" x:Name="Card1_KhuVucDuoi">
              <Border Background="#F8FAFC" BorderBrush="#E8EDF2" BorderThickness="1" CornerRadius="12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,7">
                    <Path Stroke="#F59E0B" StrokeThickness="2" Fill="None"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8,21 L12,17 L16,21 M12,17 L12,11 M7,4 L4,4 L4,11 C4,14.3 6.7,17 10,17 L14,17 C17.3,17 20,14.3 20,11 L20,4 L17,4"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="TOP RANKING" FontSize="10" FontWeight="Bold" Foreground="#64748B"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" x:Name="Card1_Rank" Margin="8,0,8,8"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- ═══════════ CARD 2 (loại lò thứ 2 trong SETTINGS.items) ═══════════ -->
      <Border Grid.Column="2" Background="White" BorderBrush="#14000000" BorderThickness="1" CornerRadius="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Header card: tên loại lò + số lò + tổng SIP (code gán theo dữ liệu thật) -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,9,14,9">
            <Ellipse Width="8" Height="8" Fill="#005696" VerticalAlignment="Center"/>
            <TextBlock x:Name="Card2_Ten" Text="---" FontSize="13" FontWeight="Bold" Foreground="#005696"
                       Margin="7,0,0,0" VerticalAlignment="Center"/>
            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="Card2_SoLuong" Text="0 lò" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
            </Border>
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6"
                    Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="Card2_TongSip" Text="0 SIP" FontSize="10" FontWeight="ExtraBold" Foreground="#005696"/>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="6*"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <!-- Bảng lò: hàng lò do code dựng vào Card2_Rows -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E8EDF2" BorderThickness="1" CornerRadius="12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Header bảng -->
                <Grid Grid.Row="0" Margin="0,7" Background="White">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.2*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2.4*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="OVEN ID" FontSize="9" Foreground="#94A3B8" Margin="10,0"/>
                  <TextBlock Grid.Column="1" Text="TRẠNG THÁI" FontSize="9" Foreground="#94A3B8"/>
                  <TextBlock Grid.Column="2" Text="HOÀN THÀNH" FontSize="9" Foreground="#94A3B8"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="Card2_Rows"/>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- Vùng dưới: TOP RANKING + popup chi tiết lò (code thêm Border vào đây) -->
            <Grid Grid.Row="2" x:Name="Card2_KhuVucDuoi">
              <Border Background="#F8FAFC" BorderBrush="#E8EDF2" BorderThickness="1" CornerRadius="12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,7">
                    <Path Stroke="#F59E0B" StrokeThickness="2" Fill="None"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8,21 L12,17 L16,21 M12,17 L12,11 M7,4 L4,4 L4,11 C4,14.3 6.7,17 10,17 L14,17 C17.3,17 20,14.3 20,11 L20,4 L17,4"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="TOP RANKING" FontSize="10" FontWeight="Bold" Foreground="#64748B"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" x:Name="Card2_Rank" Margin="8,0,8,8"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</Window>
